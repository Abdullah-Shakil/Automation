# Copy to .env for the dashboard on this PC:  cp .env.example .env
# Do not commit .env. Put the same DATABASE_URL and USER_AGENT in GitHub Actions secrets
# so the scheduled worker can reach the database with this PC off.
#
# Leave every API key empty here. Paste real values only into your private .env
# and into GitHub → Settings → Secrets and variables → Actions.
# Do NOT put a GitHub PAT / GITHUB_TOKEN in this file — fine-grained dispatch
# tokens belong in cron-job.org (or Cloudflare), not in Leadlane.

# sqlite for a trial on one machine. If SUPABASE_URL + SUPABASE_DB_PASSWORD are set
# below, Leadlane switches to that Postgres automatically while DATABASE_URL stays sqlite.
DATABASE_URL=sqlite:///./data/leadlane.db
# Or paste the Supabase session pooler URI yourself (for Actions secrets too):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase project (Settings -> API / Database). Password is the database password, not the anon key.
SUPABASE_URL=
SUPABASE_DB_PASSWORD=
# e.g. eu-central-1 — required on many free projects (direct db.* is IPv6-only).
SUPABASE_DB_REGION=
# Optional; Leadlane talks to Postgres directly and does not need the service role for CRUD.
SUPABASE_SERVICE_ROLE_KEY=

# How times are shown in the dashboard. Quota windows use each source's own timezone.
USAGE_TIMEZONE=Europe/London

# How often the cloud worker looks for a running bot, in seconds, inside one cloud run.
# The dashboard on this PC does not collect. Do not set LEADLANE_CLOUD_WORKER here.
WORKER_POLL_SECONDS=3
# Consecutive temporary failures before a bot is marked error.
MAX_CONSECUTIVE_ERRORS=5

# Polite gaps between calls from one worker process.
NOMINATIM_MIN_INTERVAL_SECONDS=1.1
OVERPASS_MIN_INTERVAL_SECONDS=2
COMPANIES_HOUSE_MIN_INTERVAL_SECONDS=0.6
WIKIDATA_MIN_INTERVAL_SECONDS=1.2
SERPER_MIN_INTERVAL_SECONDS=1.0
TAVILY_MIN_INTERVAL_SECONDS=1.0
SERPAPI_MIN_INTERVAL_SECONDS=1.5

# Identify the app. Nominatim and Wikidata reject a browser-like agent and a
# placeholder inbox such as example.com (HTTP 403). Put a real contact email you control.
USER_AGENT=Leadlane/1.0 (UK small-business research; contact: you@yourdomain.com)

# --- Source / worker API keys (all empty in the example) ---
# Paste keys into .env after you sign up. Restart the dashboard after editing.
# Mirror the same keys in GitHub Actions secrets for the cloud collector.

# Companies House (free): https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# Google Places (Maps Platform): https://console.cloud.google.com/google/maps-apis
GOOGLE_PLACES_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq — https://console.groq.com/keys
GROQ_API_KEY=
# Serper (Google search, free trial) — https://serper.dev/
SERPER_API_KEY=
# Tavily (AI search, free plan) — https://app.tavily.com/home
TAVILY_API_KEY=
# SerpApi (Google SERP, free plan) — https://serpapi.com/
SERPAPI_API_KEY=

# Contact unlockers (from Information Hunters)
# ScrapingBee — https://app.scrapingbee.com/
SCRAPINGBEE_API_KEY=
# Apify — https://console.apify.com/account/integrations
APIFY_TOKEN=
APIFY_ACTOR_ID=

# No keys: OpenStreetMap (Overpass), Wikidata — work with USER_AGENT alone.

# Cloud hosts. Leave blank to keep them off. Set to true only after the README step.
# These flags do not collect. They only mark the host as on in the dashboard.
LEADLANE_GITHUB_SCHEDULE=
LEADLANE_CRONJOB_ORG=
LEADLANE_CLOUDFLARE_CRON=
LEADLANE_VERCEL_CRON=
LEADLANE_GCP_CRON=
LEADLANE_RENDER=
LEADLANE_APIFY_HOST=

# Override only if you need a different public endpoint.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OVERPASS_URL=https://overpass-api.de/api/interpreter
COMPANIES_HOUSE_API_BASE=https://api.company-information.service.gov.uk
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
