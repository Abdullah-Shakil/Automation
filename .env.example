# Copy to .env for local development:  cp .env.example .env
# Do not commit .env. On the free host, set the same values in the environment.

# development | production
# production refuses to boot if SECRET_KEY or ADMIN_PASSWORD are still the defaults.
ENVIRONMENT=development

# Session signing key. Use a long random string in production, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

# Single admin login. Change both before exposing the app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# sqlite (local, web and worker on one machine) or Postgres (web and worker in separate processes).
# postgres:// URLs from Neon or Supabase are rewritten for SQLAlchemy.
DATABASE_URL=sqlite:///./data/leadlane.db
# DATABASE_URL=postgresql+psycopg://leadlane:leadlane@localhost:5432/leadlane

# How times are shown in the website. Quota windows use each source's own timezone.
USAGE_TIMEZONE=Europe/London

# How often the worker looks for a running bot, in seconds.
WORKER_POLL_SECONDS=3
# Consecutive temporary failures before a bot is marked error.
MAX_CONSECUTIVE_ERRORS=5

# Polite gaps between calls from one worker process.
NOMINATIM_MIN_INTERVAL_SECONDS=1.1
OVERPASS_MIN_INTERVAL_SECONDS=2
COMPANIES_HOUSE_MIN_INTERVAL_SECONDS=0.6
DIRECTORY_MIN_INTERVAL_SECONDS=2
WIKIDATA_MIN_INTERVAL_SECONDS=1.2

# Identify the app. Nominatim and Wikidata reject a browser-like agent and a
# placeholder inbox such as example.com (HTTP 403). For ongoing use, put a
# contact address you control in this string. Do not use example.com.
USER_AGENT=Leadlane/1.0 (UK small-business research)

# Companies House public API key (free): https://developer.company-information.service.gov.uk/
# Leave blank and this source stays unavailable. 600 requests per 5 minutes, shared by every bot on the key.
COMPANIES_HOUSE_API_KEY=

# Google Places is off unless BOTH of these are set. A billing account is required.
# Phone and website fields are Text Search Enterprise: 1,000 free calls a month, then Google charges.
# The bot hard-caps at 1,000 requests a month (midnight US Pacific). Other Google products on the same project can still bill.
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=

# Optional directory search. {keyword}, {location} and {page} are URL-encoded.
# The adapter fetches robots.txt first and refuses the bot if the URL is disallowed.
# Politeness cap: 200 page fetches per UK day, shared by directory bots.
DIRECTORY_SEARCH_URL_TEMPLATE=
DIRECTORY_NAME=Business directory

# Override only if you need a different public endpoint.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OVERPASS_URL=https://overpass-api.de/api/interpreter
COMPANIES_HOUSE_API_BASE=https://api.company-information.service.gov.uk
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
